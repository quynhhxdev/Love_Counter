<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_container_native"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:padding="12dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="#E5E5E5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- App Icon Skeleton -->
        <View
            android:id="@+id/sk_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Advertiser Skeleton -->
        <View
            android:id="@+id/sk_advertiser"
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintBottom_toBottomOf="@+id/sk_icon"
            app:layout_constraintStart_toEndOf="@+id/sk_icon"
            app:layout_constraintTop_toTopOf="@+id/sk_icon" />

        <!-- Ad Badge Skeleton -->
        <View
            android:id="@+id/sk_badge"
            android:layout_width="28dp"
            android:layout_height="16dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Media View Skeleton -->
        <View
            android:id="@+id/sk_media"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sk_icon" />

        <!-- Headline Skeleton -->
        <View
            android:id="@+id/sk_headline"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sk_media" />

        <!-- Body Skeleton -->
        <View
            android:id="@+id/sk_body"
            android:layout_width="240dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sk_headline" />

        <!-- CTA Button Skeleton -->
        <View
            android:id="@+id/sk_cta"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/gnt_rounded_corners_shape"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sk_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
