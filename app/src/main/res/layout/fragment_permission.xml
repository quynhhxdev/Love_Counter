<?xml version="1.0" encoding="utf-8"?>
<!-- Permission destination. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_65dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_20dp"
        android:text="@string/permission_title"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_size_20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Heart Lock Illustration -->
    <ImageView
        android:id="@+id/imgHeartLock"
        android:layout_width="@dimen/_200dp"
        android:layout_height="@dimen/_176dp"
        android:layout_marginTop="@dimen/spacing_20dp"
        android:contentDescription="@string/permission_title"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_love_permission"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader" />

    <!-- Description Text -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:paddingHorizontal="@dimen/spacing_30dp"
        android:text="@string/permission_description"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/text_size_14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgHeartLock" />

    <!-- Pill-shaped Permission Switch Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPermissionContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46dp"
        android:layout_marginHorizontal="@dimen/spacing_20dp"
        android:layout_marginTop="@dimen/spacing_20dp"
        android:background="@drawable/bg_permission_container"
        android:paddingHorizontal="@dimen/spacing_20dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDescription">

        <TextView
            android:id="@+id/tvAllowAccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:text="@string/allow_access"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchPermission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbTint="@color/switch_thumb_color"
            app:trackTint="@color/switch_track_color" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Continue Action Text Button -->
    <TextView
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:padding="@dimen/_12dp"
        android:text="@string/continue_text"
        android:textColor="@color/primary_pink"
        android:textSize="@dimen/text_size_18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clPermissionContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
