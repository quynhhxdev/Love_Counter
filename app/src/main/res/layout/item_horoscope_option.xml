<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardHoroscope"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_156dp"
    android:layout_margin="@dimen/spacing_6dp"
    android:background="@drawable/bg_input_box"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_18dp">

    <ImageView
        android:id="@+id/imgZodiacIcon"
        android:layout_width="@dimen/_120dp"
        android:layout_height="@dimen/_120dp"
        android:contentDescription="@string/access_zodiac"
        android:scaleType="fitCenter" />

</LinearLayout>