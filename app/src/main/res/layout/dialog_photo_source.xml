<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="@string/select_option"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_size_16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_108dp"
        android:layout_marginTop="@dimen/text_size_18sp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/optionTakePhoto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_photo_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/spacing_30dp"
                android:layout_height="@dimen/spacing_30dp"
                android:contentDescription="@string/take_photo_accessibility"
                android:src="@drawable/ic_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_9dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/take_photo"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_13sp" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/_8dp"
            android:layout_height="@dimen/spacing_1dp" />

        <LinearLayout
            android:id="@+id/optionUploadPhoto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_photo_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/spacing_30dp"
                android:layout_height="@dimen/spacing_30dp"
                android:contentDescription="@string/upload_photo_accessibility"
                android:src="@drawable/ic_upload" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_9dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/upload_photo"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
