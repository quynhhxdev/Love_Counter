<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPreviousMonth"
            android:layout_width="@dimen/_40dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/primary_pink"
            android:textSize="@dimen/text_size_30sp" />

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:gravity="center"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_16sp" />

        <TextView
            android:id="@+id/btnNextMonth"
            android:layout_width="@dimen/_40dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/primary_pink"
            android:textSize="@dimen/text_size_30sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/calendarGrid"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_280dp"
        android:layout_marginTop="@dimen/_8dp"
        android:columnCount="7"
        android:rowCount="7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48dp"
        android:layout_marginTop="@dimen/_12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDate"
            android:layout_width="@dimen/_76dp"
            android:layout_height="@dimen/_40dp"
            android:background="@drawable/bg_calendar_cancel"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_13sp" />

        <Space
            android:layout_width="@dimen/spacing_10dp"
            android:layout_height="@dimen/spacing_1dp" />

        <TextView
            android:id="@+id/btnSaveDate"
            android:layout_width="@dimen/_88dp"
            android:layout_height="@dimen/_40dp"
            android:background="@drawable/bg_button_pink"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/plus_jakarta_sans_medium"
            android:gravity="center"
            android:text="@string/save"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_13sp" />
    </LinearLayout>
</LinearLayout>
