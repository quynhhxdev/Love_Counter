<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56dp"
        android:paddingHorizontal="@dimen/_16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_24dp"
            android:layout_height="@dimen/_24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/memory_tab"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnSaveMemory"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_20dp">

            <!-- Photo Container Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_180dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/secondary_text"
                app:cardCornerRadius="@dimen/text_size_14sp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgSelectedPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgPlusAdd"
                    android:layout_width="@dimen/_40dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/add_photo"
                    android:src="@drawable/ic_btn_add"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/tap_to_add_photo"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/text_size_14sp" />

            <!-- Title Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_120dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="@string/title"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/text_size_14sp" />

            <EditText
                android:id="@+id/etMemoryTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44dp"
                android:layout_marginTop="@dimen/spacing_6dp"
                android:background="@drawable/bg_input_box"
                android:fontFamily="@font/plus_jakarta_sans"
                android:hint="@string/memory_title_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="@dimen/spacing_14dp"
                android:textColor="@color/primary_text"
                android:textColorHint="#A0A0A5"
                android:textSize="@dimen/text_size_14sp" />

            <!-- Date of memory Field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="@string/date_of_memory"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/text_size_14sp" />

            <RelativeLayout
                android:id="@+id/btnDateSelect"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44dp"
                android:layout_marginTop="@dimen/spacing_6dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="@dimen/text_size_14sp">

                <TextView
                    android:id="@+id/tvDateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="@string/date_format_hint"
                    android:textColor="@color/primary_text"
                    android:textColorHint="#A0A0A5"
                    android:textSize="@dimen/text_size_14sp" />

                <ImageView
                    android:layout_width="@dimen/spacing_18dp"
                    android:layout_height="@dimen/spacing_18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/calendar"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/secondary_text" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Save Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveMemory"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48dp"
        android:layout_marginHorizontal="@dimen/spacing_20dp"
        android:layout_marginBottom="@dimen/_24dp"
        android:background="@drawable/bg_button_pink"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_14sp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Banner Ad Container (Managed globally by MainActivity) -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
