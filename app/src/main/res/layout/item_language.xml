<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50dp"
    android:layout_marginHorizontal="@dimen/_16dp"
    android:layout_marginVertical="@dimen/_4dp"
    android:background="@drawable/bg_item_language"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_16dp">

    <!-- Circular Flag Icon -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFlag"
        android:layout_width="@dimen/_32dp"
        android:layout_height="@dimen/_32dp"
        android:contentDescription="@string/access_flag"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_language_eng"
        app:shapeAppearanceOverlay="@style/CircleImageView" />

    <!-- Language Name -->
    <TextView
        android:id="@+id/tvLanguageName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16dp"
        android:layout_weight="1"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        android:text="@string/english_language_name"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_size_16sp" />

</LinearLayout>