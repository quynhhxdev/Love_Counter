<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="@dimen/spacing_20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="@dimen/spacing_36dp"
        android:layout_height="@dimen/_4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_4dp"
        android:background="@drawable/bg_handle_bar" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16dp"
        android:fontFamily="@font/plus_jakarta_sans_bold"
        android:text="@string/choose_background_title"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_size_16sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBackgrounds"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_450dp"
        tools:listitem="@layout/item_background_option"
        android:layout_marginTop="@dimen/_16dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_16dp" />

</LinearLayout>