<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56dp"
        android:paddingHorizontal="@dimen/_16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/spacing_14dp"
            android:layout_height="@dimen/spacing_14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/result"
            android:textColor="@color/primary_text"
            android:textSize="@dimen/text_size_20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/llBottomButtons"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/_24dp">

            <!-- Gradient Heart with Score Percentage -->
            <FrameLayout
                android:layout_width="@dimen/_180dp"
                android:layout_height="@dimen/_162dp"
                android:layout_marginTop="@dimen/_8dp">

                <com.example.lovecounter.component.common.LiquidHeartView
                    android:id="@+id/liquidHeartResult"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:lh_progress="0"
                    app:lh_tiltEnabled="true"
                    app:lh_waveEnabled="true" />

                <TextView
                    android:id="@+id/tvScorePercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_16dp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="@string/sample_percentage"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_41sp" />
            </FrameLayout>

            <!-- Avatars and Infinity Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.example.lovecounter.component.common.ProfileAvatarView
                    android:id="@+id/avatarUserResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="@dimen/spacing_48dp"
                    android:layout_height="@dimen/spacing_48dp"
                    android:layout_marginHorizontal="@dimen/spacing_20dp"
                    android:layout_marginBottom="@dimen/_16dp"
                    android:contentDescription="@string/access_infinity"
                    android:src="@drawable/ic_alpha" />

                <com.example.lovecounter.component.common.ProfileAvatarView
                    android:id="@+id/avatarPartnerResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Advice Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24dp"
                app:cardBackgroundColor="#FFE8ED"
                app:cardCornerRadius="@dimen/_16dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:padding="@dimen/spacing_20dp"
                    android:text="@string/you_should_be_friends_not_fall_in_love_it_will_either_be_the_best_relationship_of_your_life_or_you_will_lose_that_person_forever_sometimes_the_greatest_love_stories_are_the_ones_that_remain_unspoken_between_best_friends"
                    android:textColor="@color/primary_text"
                    android:textSize="@dimen/text_size_16sp" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons: Share and Retry -->
    <LinearLayout
        android:id="@+id/llBottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_20dp"
        android:layout_marginBottom="@dimen/_32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48dp"
            android:layout_marginEnd="@dimen/_8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_share"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/share"
            android:textAllCaps="false"
            android:textColor="#FF0845"
            android:textSize="@dimen/text_size_14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRetry"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48dp"
            android:layout_marginStart="@dimen/_8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_pink"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>